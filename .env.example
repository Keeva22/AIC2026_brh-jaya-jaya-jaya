# ============================================================
# .env.example
# ============================================================
# Copy this file to '.env' and fill in your own values.
# The actual '.env' file is listed in .gitignore and should NEVER
# be committed to version control (it contains secrets).
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your values
# ============================================================

# PostgreSQL credentials
# These are used by both the 'db' and 'api' services in docker-compose.yml.
POSTGRES_USER=qc_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=qc_db
